{
  "name": "dungeons",
  "private": true,
  "version": "0.9.9",
  "type": "module",
  "description": "A browser-based roguelike dungeon crawler (Phaser + Vite PWA).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node e2e/runner.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md}\"",
    "balance": "node scripts/balance-sim.js",
    "build:dashboard": "node scripts/build-dashboard-worker.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run build && npm run check:bundle",
    "check:full": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.56.1",
    "prettier": "^3.9.5",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  }
}
